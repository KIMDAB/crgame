# Copy to docker/.env on the VM and fill in real values.
# docker compose -f docker-compose.prod.yml automatically loads this file.

# --- Managed DB (Supabase Postgres, Tokyo / ap-northeast-1) ---
# username is "postgres.<project-ref>" from Supabase → Connect → Session pooler.
RDS_POSTGRES_USERNAME=postgres.your_project_ref
RDS_POSTGRES_PASSWORD=your_postgres_password

# FIRST boot on an empty DB only: set to "update" so Hibernate creates the
# tables, then delete this line (defaults back to validate). Leave unset normally.
# DDL_AUTO=update

# --- Managed Redis (Aiven Valkey) ---
# Not wired up yet. Any non-empty value works for now; the app boots without
# connecting. Replace with the real Aiven password when adding in-game features.
CACHE_VALKEY_PASSWORD=placeholder

# --- Auth ---
JWT_PRIVATE_KEY=your_jwt_private_key
# Kakao uses the native-SDK flow (client sends access token; backend calls
# /v2/user/me). No client-id / redirect-uri needed on the backend.

# --- Shared-VM settings ---
# Public host port the cnr nginx is published on. cnr is reachable at
# http://<vm-ip>:${CNR_HTTP_PORT}. Must differ from the existing app's :8000
# and be opened in the EC2 security group. Default 8081.
CNR_HTTP_PORT=8081

# JVM memory for the app container. Sized for a 1GB VM shared with another app.
# Requires host swap (see docker/README-deploy.md). Raise on a bigger instance.
JAVA_OPTS=-Xmx512m -Xms256m
