# Copy to docker/.env on the VM and fill in real values.
# docker compose -f docker-compose.prod.yml automatically loads this file.

# --- Managed DB (Supabase Postgres) ---
RDS_POSTGRES_USERNAME=your_postgres_username
RDS_POSTGRES_PASSWORD=your_postgres_password

# --- Managed Redis (Aiven Valkey) ---
CACHE_VALKEY_PASSWORD=your_valkey_password

# --- Auth ---
JWT_PRIVATE_KEY=your_jwt_private_key
KAKAO_CLIENT_ID=kakao app client id
KAKAO_REDIRECT_URI=https://<your-new-domain>/login/oauth2/code/kakao

# --- Shared-VM settings ---
# Local host port the cnr nginx binds to (127.0.0.1 only). The front reverse
# proxy forwards the cnr domain here. Pick a port no other project uses.
CNR_HTTP_PORT=8082

# JVM memory for the app container. Tune to the VM size shared with other apps.
JAVA_OPTS=-Xmx1g -Xms512m
